APP_ENV=development
# En produccion ambos deben ser el mismo origen HTTPS, por ejemplo https://correo.tudominio.com
PUBLIC_BASE_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173
# Copiar la URL exacta mostrada por ChatGPT en la configuracion del servidor MCP.
OAUTH_REDIRECT_URIS=["https://chatgpt.com/connector_platform_oauth_redirect"]
JWT_SECRET=CHANGE_ME_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_MINUTES=30
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DATABASE_URL=postgresql+psycopg://corporate_mail_app:CHANGE_ME@127.0.0.1:5432/corporate_mail_ai
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=3
DATABASE_POOL_TIMEOUT=10
DATABASE_CONNECT_TIMEOUT=5
# Clave aleatoria de 32 bytes codificada en Base64 URL-safe; guardar fuera de PostgreSQL.
MAILBOX_ENCRYPTION_KEY=
MAILBOX_ENCRYPTION_KEY_VERSION=1
IMAP_TIMEOUT=10
IMAP_MAX_MESSAGE_BYTES=1048576
IMAP_ALLOW_PRIVATE_HOSTS=false
