# Interfaz Vue en public_html. /api, /mcp, /oauth y /.well-known/oauth-* no llegan aqui:
# los atiende el proxy de Apache (proxy.conf) antes de buscar archivos.
DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

RewriteCond %{HTTPS} off
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Otras rutas .well-known (validacion de AutoSSL aparte) responden 404, no la interfaz.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^\.well-known/ - [R=404,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
<FilesMatch "^index\.html$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>
